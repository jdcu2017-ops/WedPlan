# --- Database ---
DATABASE_URL=postgres://wedplan:wedplan_dev_password@localhost:5432/wedplan
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
MFA_ISSUER=WedPlan
MFA_TICKET_TTL=5m
# 32-byte key (base64 or hex) used to encrypt mfa_secret at rest — never reuse across purposes
ENCRYPTION_KEY=changeme

# --- Email (Postmark or SendGrid) ---
EMAIL_PROVIDER=postmark
EMAIL_API_KEY=changeme
EMAIL_FROM_ADDRESS=notifications@yourdomain.com
EMAIL_INBOUND_WEBHOOK_SECRET=changeme

# --- Payments ---
STRIPE_SECRET_KEY=changeme
STRIPE_WEBHOOK_SECRET=changeme
STRIPE_CONNECT_CLIENT_ID=changeme
# Platform commission taken as a Stripe application fee on each destination charge
PLATFORM_COMMISSION_PCT=10

# --- File storage ---
S3_BUCKET=wedplan-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme

# --- E-signature ---
ESIGN_PROVIDER=docusign
ESIGN_API_KEY=changeme

# --- App ---
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
